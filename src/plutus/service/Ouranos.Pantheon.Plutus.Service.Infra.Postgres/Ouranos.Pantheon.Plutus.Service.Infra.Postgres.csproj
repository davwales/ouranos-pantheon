<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="$(MicrosoftEntityFrameworkCoreDesignVersion)">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\core\Ouranos.Pantheon.Core.Infra.Postgres\Ouranos.Pantheon.Core.Infra.Postgres.csproj"/>
        <ProjectReference Include="..\Ouranos.Pantheon.Plutus.Service.Application\Ouranos.Pantheon.Plutus.Service.Application.csproj"/>
        <ProjectReference Include="..\Ouranos.Pantheon.Plutus.Service.Domain\Ouranos.Pantheon.Plutus.Service.Domain.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\..\..\gateway\Ouranos.Pantheon.Gateway.API\appsettings.json" 
                Condition="Exists('..\..\..\gateway\Ouranos.Pantheon.Gateway.API\appsettings.json')">
            <Link>appsettings.json</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>

        <Content Include="..\..\..\gateway\Ouranos.Pantheon.Gateway.API\appsettings.Development.json" 
                Condition="Exists('..\..\..\gateway\Ouranos.Pantheon.Gateway.API\appsettings.Development.json')">
            <Link>appsettings.Development.json</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

</Project>
