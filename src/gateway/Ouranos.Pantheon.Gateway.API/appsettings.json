{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CorsAllowedHosts": [
    "http://localhost:3000",
    "http://localhost:8300",
    "https://localhost:9300",
    "http://talos.local",
    "http://ouranos.local"
  ],
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Ouranos": {
    "Postgres": {
      "Host": "localhost",
      "Port": 5432,
      "Database": "pantheon"
    },
    "OuranosMl": {
      "ConnectionString": "http://*:*"
    }
  }
}