{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CorsAllowedHosts": [
    "http://localhost:3000",
    "http://localhost:8300",
    "https://localhost:9300",
    "http://talos.local",
    "http://ouranos.local"
  ],
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Verbose"
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Ouranos": {
    "Mongo": {
      "ConnectionString": "mongodb://*:*",
      "AssemblyDatabases": {
        "Ouranos.Pantheon.Service.Hermes.Domain": "hermes",
        "Ouranos.Pantheon.Service.Plutus.Domain": "plutus"
      }
    },
    "OuranosMl": {
      "ConnectionString": "http://*:*"
    }
  }
}