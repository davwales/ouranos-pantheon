{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Grafana.Loki"
    ],
    "MinimumLevel": {
      "Default": "Debug"
    },
    "WriteTo": [
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://loki-gateway:3100",
          "labels": [
            {
              "key": "app",
              "value": "Ouranos.Gateway"
            }
          ],
          "propertiesAsLabels": [
            "app"
          ]
        }
      }
    ]
  },
  "Schemas": {
    "Aphrodite": "http://aphrodite-service:8301/graphql",
    "Plutus": "http://plutus-service:8302/graphql"
  }
}