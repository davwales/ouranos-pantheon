{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Verbose"
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Ouranos": {
    "WebSocket": {
      "Host": "wss://stream.data.alpaca.markets/v2/iex"
    },
    "Alpaca": {
      "Symbols": [
        "AAPL"
      ]
    }
  }
}
