{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CorsAllowedHosts": [
    "http://localhost:3000",
    "http://localhost:8300",
    "https://localhost:9300",
    "http://talos.local",
    "http://ouranos.local"
  ],
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Ouranos": {
    "Postgres": {
      "Host": "localhost",
      "Port": 5432,
      "Database": "pantheon"
    },
    "OuranosMl": {
      "ConnectionString": "http://*:*"
    },
    "RabbitMq": {
      "RetryCount": 5
    },
    "Plutus": {
      "DataLoaders": {
        "Ffxiv": {
          "WebSocket": {
            "Host": "wss://universalis.app/api/ws"
          },
          "XivApi": {
            "BaseAddress": "https://raw.githubusercontent.com/xivapi/"
          },
          "Worlds": [65]
        },
        "Osrs": {
          "Wiki": {
            "BaseAddress": "https://prices.runescape.wiki/api/v1/osrs/"
          }
        },
        "Stocks": {
          "WebSocket": {
            "Host": "wss://stream.data.alpaca.markets/v2/iex"
          },
          "Symbols": ["AAPL"]
        },
        "Consumer": {
          "MarketMap": {
            "Osrs": "d71d7207-e30b-404f-8797-0148ad88cf9e",
            "Ffxiv": "411b954f-5834-462e-9887-26d3ad76c924",
            "Stocks": "daebf0a1-b54d-44f4-9c21-6654c505169a"
          }
        }
      }
    }
  }
}
