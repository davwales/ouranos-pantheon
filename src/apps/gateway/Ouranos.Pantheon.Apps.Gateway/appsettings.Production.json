{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Ouranos": {
    "Observability": {
      "OtlpEndpoint": "http://alloy:4317",
      "OtlpProtocol": "grpc"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Grafana.Loki"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Warning"
        }
      },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://loki-gateway:3100",
          "labels": [
            {
              "key": "app",
              "value": "Ouranos.Pantheon.Gateway"
            }
          ],
          "propertiesAsLabels": [
            "app"
          ],
          "traceIdMode": "Body",
          "spanIdMode": "Body"
        }
      }
    ]
  }
}
