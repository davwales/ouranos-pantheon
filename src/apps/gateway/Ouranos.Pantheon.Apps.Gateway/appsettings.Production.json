{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Grafana.Loki"
    ],
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Warning"
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "GrafanaLoki",
              "Args": {
                "uri": "http://loki-gateway:3100",
                "labels": [
                  {
                    "key": "app",
                    "value": "Ouranos.Pantheon.Gateway"
                  }
                ],
                "propertiesAsLabels": [
                  "app"
                ]
              }
            }
          ]
        }
      }
    ]
  }
}
