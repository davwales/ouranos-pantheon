<Project>
    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AutoFixture" Version="4.18.*"/>
        <PackageReference Include="AutoFixture.Xunit2" Version="4.18.*"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.*"/>
        <PackageReference Include="NSubstitute" Version="5.3.*"/>
        <PackageReference Include="Shouldly" Version="4.2.*"/>
        <PackageReference Include="xunit" Version="2.9.*"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="2.9.*"/>
    </ItemGroup>

    <PropertyGroup>
        <SystemLinqAsyncVersion>6.0.*</SystemLinqAsyncVersion>
    </PropertyGroup>
</Project>